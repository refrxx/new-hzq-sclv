{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "functions": {
        "api/og.js": {
            "maxDuration": 30,
            "includeFiles": "{assets/fonts/**,img/{8*,iqro-*,tilawah-*,hafalan-*,juzamma,katalog,perkata-*}/**,img/hamzahcolor.png,img/usp*.jpg,img/preview-*.jpg}"
        },
        "api/*.js": {
            "maxDuration": 30
        }
    },
    "redirects": [
        { "source": "/produk", "destination": "/shop", "permanent": true },
        { "source": "/produk.html", "destination": "/shop", "permanent": true }
    ],
    "rewrites": [
        { "source": "/p/:id", "destination": "/api/p?id=:id" }
    ]
}
